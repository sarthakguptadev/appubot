{
  "name": "@appubot/desktop",
  "version": "2026.11.01",
  "private": true,
  "description": "AppuBot desktop — your laptop's AI agent (ACP agents + computer use), controlled from your phone over Tailscale.",
  "main": "./out/main/index.js",
  "desktopName": "appubot.desktop",
  "author": "AppuBot",
  "homepage": "https://appubot.com",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --passWithNoTests",
    "dist": "electron-vite build && electron-builder --mac --dir",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "apps-directory": "tsx scripts/composio-directory.mts",
    "apps-unavailable": "tsx scripts/composio-unavailable.mts",
    "bench": "node bench/run.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.89.1",
    "@agentclientprotocol/codex-acp": "^2.2.2",
    "@agentclientprotocol/sdk": "^1.8.0",
    "@appubot/agent-runtime": "workspace:*",
    "@appubot/chat-core": "workspace:*",
    "@appubot/client": "workspace:*",
    "@appubot/mcp-bridge": "workspace:*",
    "@appubot/protocol": "workspace:*",
    "@appubot/theme": "workspace:*",
    "@hono/node-server": "^2.1.0",
    "@novnc/novnc": "1.7.0",
    "@trycua/cua-driver": "^0.35.4",
    "croner": "^10.0.0",
    "electron-updater": "^6.6.0",
    "figma-squircle": "^1.1.0",
    "flubber": "^0.4.2",
    "grammy": "^1.46.0",
    "hono": "^4.13.0",
    "katex": "^0.19.1",
    "opusscript": "0.1.1",
    "qrcode": "^1.5.4",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "uiohook-napi": "1.5.5",
    "ws": "^8.22.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@composio/core": "^0.22.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.3.0",
    "@types/flubber": "^0.4.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dompurify": "^3.4.17",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.0",
    "electron-vite": "^5.0.0",
    "mermaid": "^12.2.0",
    "motion": "^14.1.0",
    "onnxruntime-web": "1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "zustand": "^5.0.0"
  },
  "optionalDependencies": {
    "sherpa-onnx-darwin-arm64": "2.0.0",
